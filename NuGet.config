<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Keep restores reproducible and prevent inherited workstation feeds from
       becoming accidental package dependencies. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
