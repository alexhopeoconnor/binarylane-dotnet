{
  "input": "binarylane-v2.openapi.yaml",
  "normalizationRules": [
    {
      "kind": "exclude-paths-containing",
      "value": "#",
      "reason": "The upstream document uses fragment-bearing paths to document variants of the one real server actions endpoint. A URI fragment is never sent in an HTTP request."
    },
    {
      "kind": "preserve-discriminator",
      "schema": "ServerAction",
      "property": "type",
      "reason": "The action body is a discriminated union. Do not flatten or silently discard the discriminator mapping when generating test fixtures or internal wire code."
    },
    {
      "kind": "open-enum",
      "reason": "Provider enum values are represented as strings in public DTOs so new upstream values remain readable by existing SDK versions."
    }
  ],
  "excludedPaths": [
    "/v2/servers/{server_id}/actions#AddDisk",
    "/v2/servers/{server_id}/actions#AttachBackup",
    "/v2/servers/{server_id}/actions#ChangeAdvancedFeatures",
